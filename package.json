{
  "name": "redmine-pm-report",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "webapp",
    "batch"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
